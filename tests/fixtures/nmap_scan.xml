<?xml version="1.0" encoding="UTF-8"?>
<nmaprun scanner="nmap" args="nmap -oX - -Pn -sV api.acme.example">
<host>
<status state="up" reason="user-set"/>
<address addr="203.0.113.10" addrtype="ipv4"/>
<hostnames><hostname name="api.acme.example" type="user"/></hostnames>
<ports>
<port protocol="tcp" portid="22">
<state state="closed" reason="reset"/>
<service name="ssh" method="table" conf="3"/>
</port>
<port protocol="tcp" portid="443">
<state state="open" reason="syn-ack"/>
<service name="https" product="nginx" version="1.24.0" tunnel="ssl" method="probed" conf="10">
<cpe>cpe:/a:nginx:nginx:1.24.0</cpe>
</service>
</port>
<port protocol="tcp" portid="8080">
<state state="filtered" reason="no-response"/>
<service name="http-proxy" method="table" conf="3"/>
</port>
</ports>
</host>
</nmaprun>
